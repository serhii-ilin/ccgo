#!/usr/bin/env bash
# Executable wrapper: loads the ccgo function library and runs it.
set -u
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root="$(cd -P "$(dirname "$self")/.." && pwd)"
# Homebrew / install.sh layouts keep the library next to the bin dir or in share/.
for lib in "$(dirname "$self")/ccgo.sh" "$root/lib/ccgo.sh" "$root/share/ccgo/ccgo.sh" "$root/libexec/ccgo.sh"; do
  [ -f "$lib" ] && { . "$lib"; ccgo "$@"; exit $?; }
done
echo "ccgo: cannot find ccgo.sh library" >&2
exit 1
